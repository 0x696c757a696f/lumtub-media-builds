# Sources the libmpv builds use. mpv follows its master branch (MPV_REF is
# overridden with the commit being built); the rest are pinned releases,
# moved forward by hand after a build with the new one passes.
MPV_REF=${MPV_REF:-master}
FFMPEG_REF=${FFMPEG_REF:-n8.1.3}
DAV1D_REF=${DAV1D_REF:-1.5.4}
LIBASS_REF=${LIBASS_REF:-0.17.5}
LIBPLACEBO_REF=${LIBPLACEBO_REF:-v7.387.0}
MBEDTLS_REF=${MBEDTLS_REF:-mbedtls-3.6.7}
LUAJIT_REF=${LUAJIT_REF:-v2.1}
WAYLAND_REF=${WAYLAND_REF:-1.24.0}
WAYLAND_PROTOCOLS_REF=${WAYLAND_PROTOCOLS_REF:-1.45}
CURL_REF=${CURL_REF:-curl-8_23_0}
